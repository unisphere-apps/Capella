@page
@model Capella.Pages.AdminPanelModel
@{
    ViewData["Title"] = "Panel Administrateur";
}

<style>
    body {
        background: linear-gradient(135deg, #74ebd5, #ACB6E5);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
    }

    .admin-wrapper {
        max-width: 2000px; /* élargi */
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
        animation: fadeIn 0.6s ease-out;
    }


    h1, h2 {
        color: #343a40;
        font-weight: bold;
        margin-bottom: 20px;
    }

    button {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

        button:hover {
            opacity: 0.9;
        }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 0.95rem;
    }

    th, td {
        border: 1px solid #dee2e6;
        padding: 12px;
        text-align: left;
    }

    th {
        background-color: #f1f3f5;
    }

    tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    input[type="text"], input[type="date"] {
        border: 1px solid #ced4da;
        padding: 8px 10px;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
    }

    .btn-muted {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 6px 10px;
        border-radius: 6px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="admin-wrapper">
    <h1>Panel Administrateur</h1>

    <!-- Bouton de déconnexion -->
    <div style="text-align: right; margin-bottom: 20px;">
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="btn-danger">Déconnexion</button>
        </form>
    </div>

    <hr />

    <!-- Gestion des Publications -->
    <section>
        <h2>Gestion des Publications</h2>

        <!-- Filtres -->
        <div style="margin-bottom: 20px;">
            <input id="postSearchInput" type="text" placeholder="Rechercher une publication ou un auteur..." style="width: 300px; margin-right: 10px;" />
            <label for="postDateFrom">De :</label>
            <input id="postDateFrom" type="date" />
            <label for="postDateTo">À :</label>
            <input id="postDateTo" type="date" />
            <button id="resetFilters" type="button" class="btn-muted" style="margin-left: 10px;">Réinitialiser</button>
        </div>

        <table id="postTable">
            <thead>
                <tr>
                    <th>Auteur</th>
                    <th>Contenu</th>
                    <th>
                        Date
                        <button id="sortDateAsc" type="button" style="border: none; background: none; color: blue;">▲</button>
                        <button id="sortDateDesc" type="button" style="border: none; background: none; color: blue;">▼</button>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model.Posts)
                {
                    <tr>
                        <td class="post-author">@post.User.Nom @post.User.Prenom</td>
                        <td class="post-content">@post.Contenu</td>
                        <td class="post-date" data-date="@post.CreatedAt.ToString("yyyy-MM-dd")">
                            @post.CreatedAt.ToString("g")
                        </td>
                        <td>
                            <form method="post" asp-page-handler="DeletePost">
                                <input type="hidden" name="PostId" value="@post.Id_Post" />
                                <button type="submit" class="btn-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

@section Scripts {
    <script>
        const postSearchInput = document.getElementById('postSearchInput');
        const postDateFrom = document.getElementById('postDateFrom');
        const postDateTo = document.getElementById('postDateTo');
        const resetFilters = document.getElementById('resetFilters');
        const sortDateAsc = document.getElementById('sortDateAsc');
        const sortDateDesc = document.getElementById('sortDateDesc');
        const postTableRows = Array.from(document.querySelectorAll('#postTable tbody tr'));

        postSearchInput.addEventListener('input', filterPosts);
        postDateFrom.addEventListener('change', filterPosts);
        postDateTo.addEventListener('change', filterPosts);
        resetFilters.addEventListener('click', () => {
            postSearchInput.value = '';
            postDateFrom.value = '';
            postDateTo.value = '';
            filterPosts();
        });

        function filterPosts() {
            const searchValue = postSearchInput.value.toLowerCase();
            const dateFrom = postDateFrom.value ? new Date(postDateFrom.value) : null;
            const dateTo = postDateTo.value ? new Date(postDateTo.value) : null;

            postTableRows.forEach(row => {
                const author = row.querySelector('.post-author').textContent.toLowerCase();
                const content = row.querySelector('.post-content').textContent.toLowerCase();
                const date = new Date(row.querySelector('.post-date').dataset.date);

                const matchesSearch = author.includes(searchValue) || content.includes(searchValue);
                const matchesDate = (!dateFrom || date >= dateFrom) && (!dateTo || date <= dateTo);

                row.style.display = matchesSearch && matchesDate ? '' : 'none';
            });
        }

        sortDateAsc.addEventListener('click', () => sortPosts(true));
        sortDateDesc.addEventListener('click', () => sortPosts(false));

        function sortPosts(ascending) {
            const tbody = document.querySelector('#postTable tbody');
            const sorted = postTableRows.sort((a, b) => {
                const dateA = new Date(a.querySelector('.post-date').dataset.date);
                const dateB = new Date(b.querySelector('.post-date').dataset.date);
                return ascending ? dateA - dateB : dateB - dateA;
            });
            sorted.forEach(row => tbody.appendChild(row));
        }
    </script>
}
