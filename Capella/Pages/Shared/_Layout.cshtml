<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Capella</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Capella.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        body {
            color: #212529; /* Presque noir */
            background-color: #f4f6fa;
        }

        .navbar {
            height: 60px;
            padding: 0 1rem;
            font-size: 0.95rem;
        }

            .navbar .navbar-brand {
                font-size: 1.2rem;
                font-weight: bold;
            }


            .navbar-brand:hover, .nav-link:hover {
                text-decoration: underline;
            }

        .container {
            max-width: 860px;
            margin: 40px auto 20px auto;
            padding: 15px;
        }


        footer {
            background-color: #343a40;
            color: #ccc;
            padding: 20px 0;
            margin-top: 40px;
            text-align: center;
            font-size: 14px;
        }

            footer a {
                color: #f8f9fa;
                text-decoration: underline;
            }

        h1, h2 {
            margin-bottom: 0.5rem;
            color: #1a1a1a;
            font-size: 1.5rem;
        }
    </style>
</head>
<body>
    <header>
        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserId")))
        {
            <nav class="navbar navbar-dark" style="background: linear-gradient(to right, #007bff, #0056b3); padding: 10px 20px;">
                <div class="container-fluid d-flex justify-content-between">
                    <a class="navbar-brand text-white" asp-page="/Index" style="font-weight: bold;">Capella</a>
                    <div>
                        <a class="nav-link text-white" asp-page="/AdminPanel" style="display: inline-block; margin-right: 10px;">Administration</a>
                    </div>
                </div>
            </nav>

        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
